__pycache__/
.venv/
venv/
*.pyc
*.pyo
.env
*.log
*.bak
.claude/*
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**
# The developer guide (the deploy keeps it out of the EA's tree).
!.claude/CLAUDE.md

# Local-only development artifacts (migration notes, scratch docs, etc.)
# Personal/situational; not pushed to the EA repo.
docs/_local/

# Local secrets (open-webui key dropped in repo root)
.webui_secret_key

# The install overlay (preprocessor/install_overlay.py install): this
# install's own facts, rendered from config.
CLAUDE.local.md

# A container install's own compose additions (docs/docker.md, Web chat:
# the TLS proxy example copied next to compose.yaml).
compose.override.yaml

# The closure corpus rebuilt from the owner's own history
# (scripts/build_closure_corpus.py). Owner-private: the builder writes it
# to ~/.ea-private by default, and an in-repo copy is never tracked.
tests/fixtures/closure_corpus.real.json
*.real.json

# The macOS helper's build output (deploy/macos/tacitus-native/build.sh)
deploy/macos/tacitus-native/build/
