# Settings for compose.yaml. Copy this file to .env next to compose.yaml
# (git ignores .env) and edit the values. Every key has a default.

# The install profile written into a new ea-config.json on the first start:
# email, review-only or assistant. Later changes go in ea-config.json.
EA_PROFILE=email

# The machine's timezone, an IANA name such as America/New_York. The cron
# schedules run in it, and the EA falls back to it when the profile and the
# scheduling preferences name none.
TZ=UTC

# The owner's user name in the image, and its user and group ids. One value
# names the user, its home and the mount point of the ea-private volume.
# Match the ids to your own (`id -u`, `id -g`) when you want to read the
# volumes from the host.
OWNER_USER=owner
OWNER_UID=1000
OWNER_GID=1000
EA_GID=1001
EA_BOT_UID=999

# 0 builds the image without Playwright's Chromium (smaller; no When2Meet
# polls, JavaScript pages, email to PDF or reimbursement portals).
EA_WITH_BROWSER=1

# Mail mediation: 1 keeps the tokens with the owner-side mediator, as on a
# host install. Set 0 only to debug.
EA_MAIL_MEDIATION=1

# The web chat (assistant profile; docs/docker.md, Web chat). The address
# you open it at, behind a TLS proxy, with its path: the setup role writes
# it into the owner-private chat.json. The bot listens on port 8470 of its
# container; WEBCHAT_PORT publishes that on this machine's loopback only,
# for a proxy on this machine.
WEBCHAT_PUBLIC_URL=
WEBCHAT_PORT=8470
# The Caddy example in front of it (deploy/docker/webchat-tls/): the host
# name of WEBCHAT_PUBLIC_URL, and the ports Caddy publishes for HTTPS and
# for the HTTP redirect and the certificate check, on WEBCHAT_TLS_BIND:
# every address of this machine by default, which on a public DNS name is
# the whole internet. Name one address (a campus or VPN interface's) to
# narrow it (docs/docker.md, Web chat).
WEBCHAT_HOST=
WEBCHAT_HTTPS_PORT=443
WEBCHAT_HTTP_PORT=80
WEBCHAT_TLS_BIND=0.0.0.0

# Optional self-hosted Zulip (docker compose --profile zulip up -d).
EA_ZULIP_PORT=8090
ZULIP_HOSTNAME=zulip.localhost
ZULIP_ADMIN_EMAIL=admin@zulip.localhost
# Generate each secret with: openssl rand -hex 32
ZULIP__POSTGRES_PASSWORD=
ZULIP__MEMCACHED_PASSWORD=
ZULIP__RABBITMQ_PASSWORD=
ZULIP__REDIS_PASSWORD=
ZULIP__SECRET_KEY=
