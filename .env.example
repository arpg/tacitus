# EA System configuration (non-sensitive)
# Copy to ~/.ea/.env and fill in your values.
# This file IS readable by the ea-bot subprocess. Do NOT put Slack tokens here.
# Slack tokens go in .env.secrets (see .env.secrets.example).
#
# The systemd service and run-agent.sh both source this file automatically.

# Your private EA channel — create it in Slack, invite the bot, then
# right-click channel name → View channel details → copy the Channel ID
EA_SLACK_CHANNEL_ID=CYOUR_CHANNEL_ID
EA_SLACK_CHANNEL_NAME=ai-assistant-yourname

# Your Slack user ID — click your profile in Slack → ... → Copy member ID
# Used to verify button clicks are from the channel owner
EA_SLACK_OWNER_ID=UYOUR_USER_ID

# Zulip instead of Slack: nothing goes here. The server, bot, owner and
# streams are the `chat` block in ~/.ea/config/ea-config.json, and the
# bot's API key is ZULIP_API_KEY in .env.secrets. The EA_SLACK_* lines
# above are read only when chat.frontend is "slack" (the default).
# See docs/SETUP.md "Zulip server".

# Claude model for Slack bot responses (sonnet or opus)
EA_MODEL=sonnet

# Optional: 2captcha API key for a form or portal workflow that hits a
# CAPTCHA. Nothing consumes it automatically.
# Sign up at https://2captcha.com (~$3 deposit lasts years)
# TWOCAPTCHA_API_KEY=your-key-here

# --- Microsoft Graph API (Outlook) auth ---
# How graph_client.py authenticates. One of:
#   device_code   MSAL device code (needs "Allow public client flows = Yes")
#   interactive   MSAL browser sign-in (needs a public-client redirect URI)
#   confidential  Auth-code flow + client secret (public client flows OFF)
# Leave blank to auto-detect: a client secret => confidential, else interactive.
# An owner-side plugin can add token sources; see docs/plugins.md.
# GRAPH_AUTH_METHOD=confidential

# Application (client) ID of your Entra app registration (NOT a secret).
# GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: tenant-specific authority. Default is the multi-tenant "common"
# endpoint; set this to your tenant ID to restrict sign-in to your org.
# GRAPH_AUTHORITY=https://login.microsoftonline.com/<tenant-id>

# Redirect URI for the confidential auth-code flow. Must match a URI registered
# under the app's "Web" platform. Default: http://localhost:8400/callback
# GRAPH_REDIRECT_URI=http://localhost:8400/callback

# Requested Graph scopes, aligned at setup to what your app actually grants.
# `scripts/install/user_init.py --phase auth` writes this automatically for the confidential
# method (dropping scopes the app lacks; the code default is the full superset).
# Space-separated short names. Leave unset to request the full default set.
# GRAPH_SCOPES=Mail.ReadWrite Mail.Send Calendars.Read Contacts.Read Files.Read
#
# NOTE: For GRAPH_AUTH_METHOD=confidential, the client SECRET is sensitive and
# goes in ~/.ea/.env.secrets (see .env.secrets.example), NOT here.
